{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner && node scripts/version-service-worker.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:functions && npm run test:firestore-rules",
    "test:unit": "tsx --test tests/activityLogTimestamp.test.ts tests/dashboardNormalization.test.ts tests/globalSearch.test.ts tests/importantAlerts.test.ts tests/monthlyCash.test.ts tests/monthlyCashReconciliation.test.ts tests/orderInventoryMath.test.ts tests/orderPayments.test.ts tests/platformPermissions.test.ts tests/reportInsights.test.ts tests/workerContactAccess.test.ts",
    "test:functions": "npm --prefix functions test",
    "test:dashboard": "tsx --test tests/dashboardNormalization.test.ts",
    "test:global-search": "tsx --test tests/globalSearch.test.ts",
    "test:permissions": "tsx --test tests/platformPermissions.test.ts",
    "test:firestore-rules": "firebase emulators:exec --config firebase.rules-test.json --project wedding-manager-rules --only firestore \"tsx --test tests/firestore-rules/firestore.rules.test.ts\"",
    "test:inventory": "tsx --test tests/orderInventoryMath.test.ts",
    "test:payments": "tsx --test tests/orderPayments.test.ts",
    "test:worker-contact": "tsx --test tests/workerContactAccess.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
